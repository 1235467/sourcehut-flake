#!/bin/sh -eu
# builds.sr.ht image control for container-based build workers.
#
# Drop-in replacement for upstream's images/control: same command-line
# contract (`control <image> <cmd> [args...]`), but boots OCI containers
# (podman, optionally with the gVisor runsc runtime) instead of
# QEMU/KVM virtual machines, so it works on hosts without /dev/kvm.
#
# Guest contract (same as upstream):
#   * an sshd listening on port 22 in the container
#   * a `build` user with an empty password (PermitEmptyPasswords yes)
#   * NOPASSWD sudo for `build`
#   * bash, git, mercurial, curl, sudo, openssh installed
#
# Site overrides may be placed in $self/config.sh (generated by the
# NixOS module) or /etc/image-control.conf:
#   podman          path to podman
#   runtime         OCI runtime, e.g. runsc for gVisor (empty = default)
#
# NOTE: do not resolve $0 with readlink -f here. The NixOS module builds
# the images directory with `cp -rs`, so this script may be a symlink
# into a different store path; the generated config.sh lives next to the
# symlink, not next to the target.
self=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

podman=podman
runtime=

if [ -f "$self/config.sh" ]
then
	. "$self/config.sh"
fi

if [ -f /etc/image-control.conf ]
then
	. /etc/image-control.conf
fi

base=$1
cmd=$2
shift 2

if [ ! -d "$self/$base" ]
then
	printf "Image '%s' does not exist\n" "$base" >&2
	exit 1
fi

if [ ! -e "$self/$base/functions" ]
then
	printf "Missing base image functions '%s'\n" "$base" >&2
	exit 1
fi

ssh_opts="-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2"

guest_ssh() {
	ssh $ssh_opts "$@"
}

container_name() {
	printf "builds_job_%s" "$port"
}

_boot() {
	# A previous run killed between boot and cleanup leaves a container
	# with this name bound to the port; drop it before starting a new one.
	$podman rm -f "$(container_name)" >/dev/null 2>&1 || true
	# No explicit command: images carry their own CMD (plain sshd on most,
	# nixos runs an entrypoint that also spawns nix-daemon).
	$podman run --detach \
		${runtime:+--runtime "$runtime"} \
		--name "$(container_name)" \
		--publish "127.0.0.1:$port:22" \
		--rm \
		"$image"
}

# The release of an image is the last component of the image name:
# "alpine/edge" -> release "edge", "alpine" -> "latest".
release=${base##*/}
if [ "$release" = "$base" ]
then
	release=latest
fi

. "$self/$base/functions"

cmd_boot() {
	arch=$1
	shift

	if [ "$arch" = "default" ]
	then
		arch="$default_arch"
	fi
	if [ "$arch" != "$(uname -m)" ]
	then
		printf "Image '%s' is not available for arch '%s'\n" "$base" "$arch" >&2
		exit 1
	fi

	port=$1
	case "$port" in
		''|*[!0-9]*)
			printf "Invalid port '%s'\n" "$port" >&2
			exit 1
			;;
	esac
	if [ "$#" -gt 1 ]
	then
		shift
		runtime=$1
	fi

	boot
}

_wait_boot() {
	port=$1
	attempts=0
	echo "Waiting for container to come up..."
	while ! guest_ssh -p "$port" build@localhost echo Hello world >/dev/null 2>&1
	do
		sleep 1
		attempts=$((attempts + 1))
		if [ "$attempts" -eq 30 ]
		then
			echo "Giving up."
			cmd_cleanup "$port"
			exit 1
		fi
		echo "Attempt $attempts..."
	done
}

cmd_cleanup() {
	port=$1
	$podman rm -f "$(container_name)" >/dev/null 2>&1 || true
}

case "$cmd" in
	boot)
		cmd_boot "$@"
		;;
	cleanup)
		cmd_cleanup "$@"
		;;
	sanity-check)
		sanity_check "$@"
		;;
	install)
		install "$@"
		;;
	add-repo)
		add_repository "$@"
		;;
	ssh)
		port=$1
		shift
		guest_ssh -p "$port" build@localhost "$@"
		;;
	*)
		printf "Unknown command '%s'\n" "$cmd" >&2
		exit 1
		;;
esac
